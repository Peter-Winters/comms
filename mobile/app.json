{
  "expo": {
    "name": "Comms",
    "slug": "comms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "comms",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.pfwin.comms",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.pfwin.comms",
      "adaptiveIcon": {
        "backgroundColor": "#6C5CE7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6C5CE7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#6C5CE7",
          "defaultChannel": "messages"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Comms uses the microphone to record voice messages."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Comms lets you send photos and videos from your library.",
          "cameraPermission": "Comms lets you take photos and videos to send."
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "67e2114b-4d80-4690-8b3c-70b0c544f2f8"
      }
    },
    "owner": "peterw123"
  }
}
