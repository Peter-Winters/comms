# Copy to .env and edit, then run `npm run setup`.

# Your Matrix server name. User IDs look like @admin:<DOMAIN>.
# This cannot be changed after the first setup.
DOMAIN=comms.local

# Port the server listens on (the app connects to http://<this machine's IP>:<port>).
PORT=8008

POSTGRES_PASSWORD=change-me

# The account you sign in to the app with. Created by setup if it doesn't exist.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Bridges to run, comma separated. Available:
# whatsapp, signal, telegram, messenger, gmessages, gvoice, discord, slack, linkedin, twitter, bluesky,
# instagram (experimental: pinned to an old bridge release, may not work)
COMPOSE_PROFILES=whatsapp,signal,telegram,messenger,gmessages,discord,slack

# Required for telegram: create an app at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Push notifications. "full" shows sender + message text on your lock screen (text passes
# through Expo and Google's push service); "private" only shows "New message from X".
PUSH_CONTENT=full
